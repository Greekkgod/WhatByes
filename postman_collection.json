{
  "info": {
    "name": "Healthcare Backend System API",
    "description": "Complete Postman collection for testing Healthcare Backend APIs with JWT Authentication and PostgreSQL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "patient_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "doctor_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "mapping_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Jane Foster\",\n  \"email\": \"jane.foster@healthcare.org\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register", ""]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.tokens) {",
                  "    pm.collectionVariables.set('access_token', jsonData.data.tokens.access);",
                  "    pm.collectionVariables.set('refresh_token', jsonData.data.tokens.refresh);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"staff@healthcare.com\",\n  \"password\": \"StaffPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login", ""]
            }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me", ""]
            }
          }
        },
        {
          "name": "Refresh JWT Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/token/refresh/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "token", "refresh", ""]
            }
          }
        }
      ]
    },
    {
      "name": "2. Patient Management",
      "item": [
        {
          "name": "Add Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('patient_id', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Michael Scott\",\n  \"age\": 45,\n  \"gender\": \"Male\",\n  \"contact_number\": \"+1-555-1234\",\n  \"email\": \"michael@dundermifflin.com\",\n  \"address\": \"1725 Slough Avenue, Scranton, PA\",\n  \"medical_history\": \"Foot burned on George Foreman grill, mild asthma.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/patients/",
              "host": ["{{base_url}}"],
              "path": ["api", "patients", ""]
            }
          }
        },
        {
          "name": "List User's Patients",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/patients/",
              "host": ["{{base_url}}"],
              "path": ["api", "patients", ""]
            }
          }
        },
        {
          "name": "Get Patient Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/patients/{{patient_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "patients", "{{patient_id}}", ""]
            }
          }
        },
        {
          "name": "Update Patient Details",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Michael Gary Scott\",\n  \"age\": 46,\n  \"gender\": \"Male\",\n  \"contact_number\": \"+1-555-9999\",\n  \"email\": \"michael.scott@dundermifflin.com\",\n  \"address\": \"Scranton, PA\",\n  \"medical_history\": \"Fully healed foot burn, periodic checkups.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/patients/{{patient_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "patients", "{{patient_id}}", ""]
            }
          }
        },
        {
          "name": "Delete Patient",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/patients/{{patient_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "patients", "{{patient_id}}", ""]
            }
          }
        }
      ]
    },
    {
      "name": "3. Doctor Management",
      "item": [
        {
          "name": "Add Doctor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('doctor_id', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Allison Cameron\",\n  \"specialization\": \"Immunology\",\n  \"contact_number\": \"+1-555-4321\",\n  \"email\": \"cameron@plainsboro.edu\",\n  \"years_of_experience\": 8,\n  \"hospital_name\": \"Princeton-Plainsboro\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/doctors/",
              "host": ["{{base_url}}"],
              "path": ["api", "doctors", ""]
            }
          }
        },
        {
          "name": "List All Doctors",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/doctors/",
              "host": ["{{base_url}}"],
              "path": ["api", "doctors", ""]
            }
          }
        },
        {
          "name": "Get Doctor Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/doctors/{{doctor_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "doctors", "{{doctor_id}}", ""]
            }
          }
        },
        {
          "name": "Update Doctor Details",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Allison Cameron\",\n  \"specialization\": \"Senior Immunologist\",\n  \"contact_number\": \"+1-555-4321\",\n  \"email\": \"cameron@plainsboro.edu\",\n  \"years_of_experience\": 10,\n  \"hospital_name\": \"Princeton-Plainsboro\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/doctors/{{doctor_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "doctors", "{{doctor_id}}", ""]
            }
          }
        },
        {
          "name": "Delete Doctor",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/doctors/{{doctor_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "doctors", "{{doctor_id}}", ""]
            }
          }
        }
      ]
    },
    {
      "name": "4. Patient-Doctor Mapping",
      "item": [
        {
          "name": "Assign Doctor to Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('mapping_id', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient\": 1,\n  \"doctor\": 3,\n  \"notes\": \"Assigned for pre-operative clearance.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/mappings/",
              "host": ["{{base_url}}"],
              "path": ["api", "mappings", ""]
            }
          }
        },
        {
          "name": "List All Mappings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/mappings/",
              "host": ["{{base_url}}"],
              "path": ["api", "mappings", ""]
            }
          }
        },
        {
          "name": "Get Doctors Assigned to Specific Patient",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/mappings/{{patient_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "mappings", "{{patient_id}}", ""]
            }
          }
        },
        {
          "name": "Remove Doctor from Patient (Delete Mapping)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/mappings/{{mapping_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "mappings", "{{mapping_id}}", ""]
            }
          }
        }
      ]
    },
    {
      "name": "5. System Health",
      "item": [
        {
          "name": "Database & Server Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/health/",
              "host": ["{{base_url}}"],
              "path": ["api", "health", ""]
            }
          }
        }
      ]
    }
  ]
}
